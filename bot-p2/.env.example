# bot-persona2 (4451129186) — Grupo Pedidos + privados de clientes.
# Copiar a `.env` y completar. El `.env` real NUNCA va al repo.

# Django
DJANGO_API_URL=https://ryalsneackers.com
DJANGO_API_KEY=

# Grupos de WhatsApp
ORDERS_GROUP_ID=
SUPPLIER_GROUP_ID=
RYAL_GROUP_ID=

# Este bot NO reenvia al Grupo Ryal: de eso se encarga persona1.
FORWARD_TO_RYAL=false
MARKUP=100

# Puerto del listener de avisos de Django (persona1 usa 8952)
NOTIFY_PORT=8953

# Destino de las alertas del propio bot. Si se omite, bot.js cae al numero
# del 112 hardcodeado como fallback.
ALERT_JID=

# Numeros y/o LIDs de las OTRAS instancias que escuchan el Grupo Pedidos, para
# que sus comandos los atienda SOLO su propia instancia. Sin esto, un /cerrar
# escrito desde bot-p3 lo atienden las dos y cada una arma su sesion (el
# duplicado de los pedidos 105/106, 2026-09-20). Se aceptan telefono y LID, con
# o sin dominio y sin el sufijo de dispositivo; separados por coma.
# bot-p3 = 5214451000181 / 233299133886498
PEER_BOT_JIDS=

# LIDs que NUNCA reciben bienvenida ni menu (tus propios numeros), separados
# por coma. Va por LID exacto y no por telefono: en privados la key del
# mensaje solo trae el `@lid` (ej. 154211253772535@lid).
INTERNAL_JIDS=
# Token compartido con Django (NOTIFY_TOKEN en /root/app/.env, mismo valor).
# Sin él, /notify rechaza los avisos a clientes (target "customer") con 503.
NOTIFY_TOKEN=
