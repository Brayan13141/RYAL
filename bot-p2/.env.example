# bot-persona2 (4451129186) — Grupo Pedidos + privados de clientes.
# Copiar a `.env` y completar. El `.env` real NUNCA va al repo.

# Django
DJANGO_API_URL=https://ryalsneackers.com
DJANGO_API_KEY=

# Grupos de WhatsApp
ORDERS_GROUP_ID=
SUPPLIER_GROUP_ID=
RYAL_GROUP_ID=

# Este bot NO reenvia al Grupo Ryal: de eso se encarga persona1.
FORWARD_TO_RYAL=false
MARKUP=100

# Puerto del listener de avisos de Django (persona1 usa 8952)
NOTIFY_PORT=8953

# Destino de las alertas del propio bot. Si se omite, bot.js cae al numero
# del 112 hardcodeado como fallback.
ALERT_JID=
