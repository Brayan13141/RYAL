# bot-persona3 — instancia de COMANDOS para un numero de ventas extra.
# Copiar a `.env` y completar. El `.env` real NUNCA va al repo.
#
# Esta instancia atiende UNA sola cosa: los mensajes propios del Grupo Pedidos.
# No saluda, no atiende privados, no reenvia del proveedor. Por eso aca no hay
# SUPPLIER_GROUP_ID, RYAL_GROUP_ID, FORWARD_TO_RYAL, INTERNAL_JIDS ni
# NOTIFY_PORT: no existen los caminos que los usaban.

# Django
DJANGO_API_URL=https://ryalsneackers.com
DJANGO_API_KEY=

# El unico grupo que escucha. Sin esto no procesa nada (ver routing.js).
ORDERS_GROUP_ID=

# Margen para el costo estimado de un item de texto libre. Mismo valor que las
# otras instancias, o los costos no van a concordar entre operadores.
MARKUP=100

# Vinculacion por CODIGO en vez de QR. Con esto puesto, al arrancar sin sesion
# el bot imprime en el journal un codigo de 8 caracteres que se teclea en el
# telefono (Dispositivos vinculados -> Vincular con numero de telefono). Dura
# minutos, no los 20s que rota un QR.
#
# Formato: 521 + los 10 digitos nacionales (asi son las cuentas ya vinculadas).
# Se aceptan +, espacios y guiones. Vacio o mal formado = sigue el QR.
PAIR_NUMBER=5215550000003
